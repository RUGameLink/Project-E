REM ● Запускает «python -m uvicorn» (работает даже если uvicorn не в PATH)
chcp 65001 > nul
REM ● Переключает кодовую страницу cmd на UTF‑8, чтобы избежать «кракозябр»
REM ● После остановки процесса выдаёт код завершения и ждёт нажатие клавиши

:: ---------------------------------------------------------------------------
:: 0. Переключаем кодовую страницу (Windows 10/11) — комментарии будут читаемы
:: ---------------------------------------------------------------------------


:: ---------------------------------------------------------------------------
:: 1. Порт передаётся первым аргументом, иначе 8000
:: ---------------------------------------------------------------------------
set "APP_PORT=%1"
if "%APP_PORT%"=="" set "APP_PORT=8000"

:: ---------------------------------------------------------------------------
:: 2. Активируем виртуальное окружение .venv
:: ---------------------------------------------------------------------------
if not exist ".venv\Scripts\activate.bat" (
    echo [ERROR] Виртуальное окружение .venv не найдено. Сначала запустите run_api.bat или создайте venv.
    pause
    exit /b 1
)
call ".venv\Scripts\activate.bat"

:: ---------------------------------------------------------------------------
:: 3. Запускаем Uvicorn через «python -m», чтобы избежать проблем с PATH
:: ---------------------------------------------------------------------------
echo [INFO] Старт сервера на порту %APP_PORT% ...
python -m uvicorn main:app --host 0.0.0.0 --port %APP_PORT% --log-level info
set "RC=%ERRORLEVEL%"

:: ---------------------------------------------------------------------------
:: 4. Выводим код завершения и ждём клавишу
:: ---------------------------------------------------------------------------
if %RC% neq 0 (
    echo [ERROR] Uvicorn завершился с кодом %RC%.
) else (
    echo [INFO] Сервер остановлен пользователем.
)
pause
