@echo off
chcp 65001 > nul
echo =======================================================
echo Удаление модуля оценки моделей нейронных сетей
echo =======================================================
cd /d "%~dp0"

echo.
echo Внимание! Это действие удалит виртуальное окружение и временные файлы.
echo Данные моделей в директории model_save_preset НЕ будут затронуты.
echo.

set /p CONFIRM=Вы уверены, что хотите продолжить? (y/n): 
if /i "%CONFIRM%" NEQ "y" (
    echo Операция отменена.
    pause
    exit /b 0
)

:: Деактивация окружения, если оно активно
call venv\Scripts\deactivate.bat 2>nul

:: Ожидание освобождения файлов
timeout /t 2 > nul

:: Удаление виртуального окружения
echo Удаление виртуального окружения...
if exist venv (
    rmdir /S /Q venv
    if %ERRORLEVEL% NEQ 0 (
        echo ПРЕДУПРЕЖДЕНИЕ: Не удалось полностью удалить виртуальное окружение.
        echo Возможно, некоторые процессы все еще используют файлы.
    ) else (
        echo Виртуальное окружение успешно удалено.
    )
)

:: Удаление временных файлов
echo Удаление временных файлов...
if exist temp_uploads (
    rmdir /S /Q temp_uploads
    echo Временные файлы удалены.
)

if exist logs (
    rmdir /S /Q logs
    echo Файлы логов удалены.
)

:: Пользовательский выбор: удалить ли конфигурационный файл
echo.
set /p CONFIRM_CONFIG=Удалить файл конфигурации config.ini? (y/n): 
if /i "%CONFIRM_CONFIG%" EQU "y" (
    if exist config.ini (
        del /F /Q config.ini
        echo Файл конфигурации удален.
    )
)

echo.
echo =======================================================
echo Удаление завершено!
echo =======================================================
echo.

pause 