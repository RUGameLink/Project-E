@echo off
REM =========================================================================
REM Radon‑Forecast API — Windows launcher
REM =========================================================================

REM Порт можно переопределить, передав аргумент: run_api.bat 9000
SET "APP_PORT=%1"
IF "%APP_PORT%"=="" SET "APP_PORT=8000"

REM -------------------------------------------------------------------------
REM 1. Создаём виртуальное окружение (если ещё нет) и активируем его
REM -------------------------------------------------------------------------
IF NOT EXIST .venv (
    echo [INFO] Creating Python virtual environment...
    python -m venv .venv || GOTO :error
)
CALL .venv\Scripts\activate.bat || GOTO :error

REM -------------------------------------------------------------------------
REM 2. Обновляем pip и ставим зависимости
REM -------------------------------------------------------------------------
python -m pip install --upgrade pip > nul 2>&1 || GOTO :error
pip install -r requirements.txt || GOTO :error

REM -------------------------------------------------------------------------
REM 3. Проверяем наличие config.ini
REM -------------------------------------------------------------------------
IF NOT EXIST config.ini (
    echo [WARN] Файл config.ini не найден. Создайте его и укажите путь к моделям.
    PAUSE
)

REM -------------------------------------------------------------------------
REM 4. Запускаем Uvicorn в режиме авто‑перезагрузки
REM -------------------------------------------------------------------------
uvicorn main:app --host 0.0.0.0 --port %APP_PORT% --reload
GOTO :eof

REM -------------------------------------------------------------------------
REM 5. Простая обработка ошибок
REM -------------------------------------------------------------------------
:error
ECHO [ERROR] Произошла ошибка. Проверьте вывод выше.
PAUSE
