    import tensorflow as tf
    from tensorflow.keras.models import load_model as tf_load_model
    
    # Отключаем предупреждения TensorFlow
    tf.get_logger().setLevel('ERROR')
    warnings.filterwarnings('ignore', category=UserWarning)
    
    # Проверяем возможность декорирования функций
    if hasattr(tf.keras.saving, 'register_keras_serializable'):
        keras_serializable = tf.keras.saving.register_keras_serializable()
    else:
        # Заглушка для старых версий
        keras_serializable = lambda: (lambda x: x)
        
    @keras_serializable
    def mse_function(y_true, y_pred):
        return tf.keras.losses.mean_squared_error(y_true, y_pred)
        
    @keras_serializable
    def mae_function(y_true, y_pred):
        return tf.keras.losses.mean_absolute_error(y_true, y_pred)
        
except ImportError:
    tf = None
    keras_serializable = lambda: (lambda x: x)
    
    def tf_load_model(*args, **kwargs):
        print("TensorFlow не установлен. Используйте Python 3.10 или 3.11, или установите tensorflow>=2.16.1 вручную.")
        return None
    
    def mse_function(y_true, y_pred):
        return None
        
    def mae_function(y_true, y_pred):
        return None

# Import visualization libraries with fallbacks
try:
    import plotly.graph_objects as go
except ImportError:
    go = None
    
try:
    import numpy as np
    
    # Define np functions to use regardless of whether np is None later
    def numpy_prod(values):
        return np.prod(values)
    def numpy_linspace(start, stop, num):
        return np.linspace(start, stop, num)
    def numpy_array_linspace(start, stop, num, dtype=None):
        return np.linspace(start, stop, num, dtype=dtype)
except ImportError:
    np = None
    # Fallback implementations
    def fallback_prod(values):
        result = 1
        for v in values:
            result *= v
        return result
    def fallback_linspace(start, stop, num):
        if num <= 1:
            return [start]
        step = (stop - start) / (num - 1)
        return [start + i * step for i in range(num)]
    def fallback_array_linspace(start, stop, num, dtype=None):
        values = fallback_linspace(start, stop, num)
        if dtype == int:
            return [int(v) for v in values]
        return values
    
    # Assign appropriate implementations
    numpy_prod = fallback_prod
    numpy_linspace = fallback_linspace
    numpy_array_linspace = fallback_array_linspace
    
try:
    import matplotlib.pyplot as plt
except ImportError:
    plt = None

# Create Figure class fallback if go is None
if go is None:
    class FigureFallback:
        def __init__(self):
            self.shapes = []
            self.annotations = []
        
        def add_shape(self, **kwargs):
            self.shapes.append(kwargs)
            return self
        
        def add_annotation(self, **kwargs):
            self.annotations.append(kwargs)
            return self
        
        def update_layout(self, **kwargs):
            self.layout = kwargs
            return self
    
    class TableFallback:
        def __init__(self, **kwargs):
            self.data = kwargs
    
    class GoFallback:
        def Figure(self, data=None):
            return FigureFallback()
        
        def Table(self, **kwargs):
            return TableFallback(**kwargs)
    
    go = GoFallback()

def get_layer_dimensions(model):
    """Extract layer dimensions from a TensorFlow model."""
    layer_dims = []
    for layer in model.layers:
        # Безопасное получение input_shape
        if hasattr(layer, 'input_shape'):
            input_shape = layer.input_shape
        elif hasattr(layer, 'input'):
            input_shape = getattr(layer.input, 'shape', None)
        else:
            input_shape = "Недоступно"
            
        # Безопасное получение output_shape
        if hasattr(layer, 'output_shape'):
            output_shape = layer.output_shape
        elif hasattr(layer, 'output'):
            output_shape = getattr(layer.output, 'shape', None)
        else:
            output_shape = "Недоступно"
        
        # Handle different types of input/output shapes
        if isinstance(input_shape, list):
            input_shape = input_shape[0]
        if isinstance(output_shape, list):
            output_shape = output_shape[0]
            
        layer_dims.append({
            'name': layer.name,
            'type': layer.__class__.__name__,
            'input_shape': str(input_shape),
            'output_shape': str(output_shape)
        })
    return layer_dims

def plot_model_architecture(model):
    """Plot the architecture of a TensorFlow model with improved layout."""
    layer_dims = get_layer_dimensions(model)
    
    # Constants for visualization
    y_spacing = 120  # Vertical spacing between layers
    box_width = 300
    box_height = 100
    chart_height = max(600, (len(layer_dims) * y_spacing) + 100)
    
    fig = go.Figure()
    
    # Add shapes and annotations for each layer
    for i, layer in enumerate(layer_dims):
        y_pos = i * y_spacing
        
        # Add box for layer
        fig.add_shape(
            type="rect",
            x0=100, y0=y_pos, x1=100+box_width, y1=y_pos+box_height,
            line=dict(color="RoyalBlue", width=2),
            fillcolor="LightSkyBlue",
            opacity=0.8
        )
        
        # Add layer name and type
        fig.add_annotation(
            x=100+box_width/2, y=y_pos+20,
            text=f"<b>{layer['name']}</b>",
            showarrow=False,
            font=dict(size=14)
        )
        fig.add_annotation(
            x=100+box_width/2, y=y_pos+45,
            text=f"Type: {layer['type']}",
            showarrow=False,
            font=dict(size=12)
        )
        
        # Add input/output shapes - безопасно обрабатываем "Недоступно"
        input_shape = layer['input_shape']
        output_shape = layer['output_shape']
        
        fig.add_annotation(
            x=100+box_width/2, y=y_pos+70,
            text=f"In: {input_shape} | Out: {output_shape}",
            showarrow=False,
            font=dict(size=10)
        )
        
        # Connect layers with lines
        if i > 0:
            fig.add_shape(
                type="line",
                x0=100+box_width/2, y0=(i-1)*y_spacing+box_height,
                x1=100+box_width/2, y1=y_pos,
                line=dict(color="RoyalBlue", width=2)
            )
    
    # Update layout
    fig.update_layout(
        title="Model Architecture",
        showlegend=False,
        height=chart_height,
        width=500,
        plot_bgcolor='white',
        margin=dict(l=20, r=20, t=50, b=20),
        xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
        yaxis=dict(showgrid=False, zeroline=False, showticklabels=False)
    )
    
    return fig

def plot_model_structure_diagram(model):
    """
    Создает диаграмму структуры модели с таблицами входных и выходных размерностей,
    похожую на предоставленный пример.
    """
    if model is None or go is None:
        print("Cannot plot model structure: model or plotly is None")
        return None
    
    # Получаем информацию о слоях модели
    layer_dims = []
    for layer in model.layers:
        # Безопасное получение типа и имени слоя
        layer_type = layer.__class__.__name__
        layer_name = layer.name
        
        # Безопасное получение input_shape
        if hasattr(layer, 'input_shape'):
            input_shape = layer.input_shape
        elif hasattr(layer, 'input'):
            input_shape = getattr(layer.input, 'shape', None)
        else:
            input_shape = None
            
        # Безопасное получение output_shape
        if hasattr(layer, 'output_shape'):
            output_shape = layer.output_shape
        elif hasattr(layer, 'output'):
            output_shape = getattr(layer.output, 'shape', None)
        else:
            output_shape = None
        
        # Обработка разных типов shape
        if isinstance(input_shape, list) and len(input_shape) > 0:
            input_shape = input_shape[0]
        if isinstance(output_shape, list) and len(output_shape) > 0:
            output_shape = output_shape[0]
        
        # Преобразование формы в читаемый вид
        if input_shape:
            input_shape_str = str(input_shape)
        else:
            input_shape_str = "N/A"
            
        if output_shape:
            output_shape_str = str(output_shape)
        else:
            output_shape_str = "N/A"
        
        layer_dims.append({
            'name': layer_name,
            'type': layer_type,
            'input_shape': input_shape_str,
            'output_shape': output_shape_str
        })
    
    # Константы для визуализации
    y_spacing = 120  # Вертикальное расстояние между слоями
    box_width = 300
    box_height = 100
    chart_height = max(800, (len(layer_dims) * y_spacing) + 100)
    
    fig = go.Figure()
    
    # Добавляем прямоугольники и аннотации для каждого слоя
    for i, layer in enumerate(layer_dims):
        y_pos = i * y_spacing
        
        # Добавляем прямоугольник для слоя
        fig.add_shape(
            type="rect",
            x0=100, y0=y_pos, x1=100+box_width, y1=y_pos+box_height,
            line=dict(color="RoyalBlue", width=2),
            fillcolor="LightSkyBlue",
            opacity=0.8
            )
        
        # Добавляем имя и тип слоя
        fig.add_annotation(
            x=100+box_width/2, y=y_pos+30,
            text=f"<b>{layer['name']}</b><br>Type: {layer['type']}",
            showarrow=False,
            font=dict(size=12)
            )
        
        # Добавляем входные и выходные формы
        fig.add_annotation(
            x=100+box_width/2, y=y_pos+70,
            text=f"In: {clean_shape_string(layer['input_shape'])}<br>Out: {clean_shape_string(layer['output_shape'])}",
            showarrow=False,
            font=dict(size=10)
            )
        
        # Соединяем слои линиями
        if i > 0:
            fig.add_shape(
                type="line",
                x0=100+box_width/2, y0=(i-1)*y_spacing+box_height,
                x1=100+box_width/2, y1=y_pos,
                line=dict(color="RoyalBlue", width=2)
            )
    
    # Обновляем макет
    fig.update_layout(
        title="Структура модели",
        showlegend=False,
        height=chart_height,
        width=550,
        plot_bgcolor='white',
        margin=dict(l=20, r=20, t=50, b=20),
        xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
        yaxis=dict(showgrid=False, zeroline=False, showticklabels=False)
    )
    
    return fig

def clean_shape_string(shape_str):
    """
    Преобразует строку формы в более читаемый формат для диаграммы.
    Например, "(None, 224, 224, 3)" -> "(None, 224, 224, 3)"
    """
    # Убираем лишние символы и пробелы
    shape_str = shape_str.replace('(', '').replace(')', '')
    shape_parts = [s.strip() for s in shape_str.split(',')]
    
    if len(shape_parts) >= 4:  # Форма тензора
        return f"({shape_parts[0]}, {shape_parts[1]}, {shape_parts[2]}, {shape_parts[3]})"
    elif len(shape_parts) == 3:  # 3D форма
        return f"({shape_parts[0]}, {shape_parts[1]}, {shape_parts[2]})"
    elif len(shape_parts) == 2:  # 2D форма
        return f"({shape_parts[0]}, {shape_parts[1]})"
    elif len(shape_parts) == 1:  # 1D форма
        return f"({shape_parts[0]})"
    else:
        return shape_str

def plot_model_summary(model):
    """Generate a text summary of model layers and parameters."""
    if model is None or go is None:
        print("Cannot plot model summary: model or plotly is None")
        return None
        
    # Capture model summary as string
    string_io = io.StringIO()
    model.summary(print_fn=lambda x: string_io.write(x + '\n'))
    summary_string = string_io.getvalue()
    string_io.close()
    
    # Convert to plotly table format
    lines = summary_string.strip().split('\n')
    
    # Extract header and separator lines
    header = lines[2].strip().split()
    
    # Create table data
    table_data = []
    for i in range(3, len(lines) - 4):  # Skip header and final lines
        if '=' not in lines[i]:  # Skip separator lines
            parts = lines[i].strip().split()
            if len(parts) >= 4:
                layer_name = ' '.join(parts[:-3])
                output_shape = parts[-3] if parts[-3] != '(None,' else parts[-3] + ' ' + parts[-2]
                params = parts[-1]
                table_data.append([layer_name, output_shape, params])
    
    # Create table figure
    fig = go.Figure(data=[go.Table(
        header=dict(
            values=['Layer', 'Output Shape', 'Params'],
            fill_color='paleturquoise',
            align='left'
        ),
        cells=dict(
            values=list(zip(*table_data)),
            fill_color='lavender',
            align='left'
        )
    )])
    
    fig.update_layout(title="Model Summary", width=800)
    
    return fig

def visualize_keras_model(model_path):
    """Load and visualize a Keras model from file."""
    try:
        if tf is None:
            print("TensorFlow not available. Cannot load model.")
            return None, None, None
        
        print(f"Loading model from: {model_path}")
        
        try:
            # Базовые объекты для восстановления моделей
            custom_objects = {}
            
            # Проверяем доступность функций в TensorFlow
            tf_version = tf.__version__
            print(f"TensorFlow version: {tf_version}")
            
            # Регистрируем функции метрик 
            custom_objects['mse'] = mse_function
            custom_objects['mean_squared_error'] = mse_function
            custom_objects['mae'] = mae_function
            custom_objects['mean_absolute_error'] = mae_function
            
            # Также добавляем объекты метрик
            custom_objects.update({
                'MeanSquaredError': tf.keras.metrics.MeanSquaredError,
                'MeanAbsoluteError': tf.keras.metrics.MeanAbsoluteError,
                'accuracy': tf.keras.metrics.BinaryAccuracy(),
                'binary_accuracy': tf.keras.metrics.BinaryAccuracy(),
                'categorical_accuracy': tf.keras.metrics.CategoricalAccuracy(),
                
                # Потери
                'binary_crossentropy': tf.keras.losses.BinaryCrossentropy(),
                'categorical_crossentropy': tf.keras.losses.CategoricalCrossentropy(),
                
                # Оптимизаторы - используем legacy для совместимости
                'Adam': tf.keras.optimizers.legacy.Adam,
                'SGD': tf.keras.optimizers.legacy.SGD,
                'RMSprop': tf.keras.optimizers.legacy.RMSprop
            })
            
            # Адаптированные подклассы для правильной загрузки слоев
            class FixedLayer(tf.keras.layers.Layer):
                """Базовый слой, удаляющий несовместимые аргументы"""
                def __init__(self, *args, **kwargs):
                    # Удаляем несовместимые аргументы
                    kwargs.pop('time_major', None)
                    super().__init__(*args, **kwargs)
            
            class FixedLSTM(tf.keras.layers.LSTM):
                """LSTM с исправлением несовместимых параметров"""
                def __init__(self, *args, **kwargs):
                    # Удаляем несовместимые аргументы
                    kwargs.pop('time_major', None)
                    if 'recurrent_activation' in kwargs and kwargs['recurrent_activation'] == 'hard_sigmoid':
                        kwargs['recurrent_activation'] = 'sigmoid'
                    super().__init__(*args, **kwargs)
            
            class FixedGRU(tf.keras.layers.GRU):
                """GRU с исправлением несовместимых параметров"""
                def __init__(self, *args, **kwargs):
                    # Удаляем несовместимые аргументы
                    kwargs.pop('time_major', None)
                    if 'recurrent_activation' in kwargs and kwargs['recurrent_activation'] == 'hard_sigmoid':
                        kwargs['recurrent_activation'] = 'sigmoid'
                    super().__init__(*args, **kwargs)
            
            class FixedSimpleRNN(tf.keras.layers.SimpleRNN):
                """SimpleRNN с исправлением несовместимых параметров"""
                def __init__(self, *args, **kwargs):
                    # Удаляем несовместимые аргументы
                    kwargs.pop('time_major', None)
                    super().__init__(*args, **kwargs)
            
            # Специальная обработка для Bidirectional wrapper
            def fixed_bidirectional_deserialize(config, custom_objects=None):
                """Создаем Bidirectional-слой с исправленными параметрами"""
                # Получаем класс для десериализации
                layer_config = config.copy()
                
                # Проверяем и исправляем слой внутри
                if 'layer' in layer_config:
                    inner_layer_config = layer_config['layer']
                    # Проверяем класс слоя
                    if 'class_name' in inner_layer_config:
                        # Исправляем конфигурацию внутреннего слоя
                        inner_config = inner_layer_config.get('config', {})
                        inner_config.pop('time_major', None)
                        if 'recurrent_activation' in inner_config and inner_config['recurrent_activation'] == 'hard_sigmoid':
                            inner_config['recurrent_activation'] = 'sigmoid'
                        inner_layer_config['config'] = inner_config
                        layer_config['layer'] = inner_layer_config
                
                # Создаем слой из исправленной конфигурации
                return tf.keras.layers.Bidirectional.from_config(layer_config, custom_objects)
            
            # Регистрируем кастомную функцию десериализации
            custom_objects['Bidirectional'] = fixed_bidirectional_deserialize
            
            # Добавляем исправленные классы слоев в словарь объектов
            custom_objects.update({
                'LSTM': FixedLSTM,
                'GRU': FixedGRU,
                'SimpleRNN': FixedSimpleRNN,
                'Layer': FixedLayer,
            })
            
            # Пробуем различные способы загрузки модели
            model = None
            errors = []
            
            # Попытка 1: С кастомными объектами, без компиляции
            try:
                # Патчим метод загрузки для обработки unsupported keyword arguments
                original_from_config = tf.keras.layers.SimpleRNN.from_config
                
                def patched_from_config(cls, config):
                    # Удаляем несовместимые аргументы
                    config.pop('time_major', None)
                    if 'recurrent_activation' in config and config['recurrent_activation'] == 'hard_sigmoid':
                        config['recurrent_activation'] = 'sigmoid'
                    return original_from_config(config)
                
                # Временно заменяем метод
                tf.keras.layers.SimpleRNN.from_config = classmethod(patched_from_config)
                tf.keras.layers.LSTM.from_config = classmethod(patched_from_config)
                tf.keras.layers.GRU.from_config = classmethod(patched_from_config)
                
                # Загружаем модель 
                model = tf.keras.models.load_model(model_path, custom_objects=custom_objects, compile=False)
                print("Успешно загружена модель с кастомными объектами, без компиляции")
                
                # Восстанавливаем оригинальный метод
                tf.keras.layers.SimpleRNN.from_config = original_from_config
                tf.keras.layers.LSTM.from_config = original_from_config
                tf.keras.layers.GRU.from_config = original_from_config
                
            except Exception as e:
                errors.append(f"Ошибка при загрузке с кастомными объектами, без компиляции: {e}")
                
                # Восстанавливаем оригинальный метод, если он был изменен
                if 'original_from_config' in locals():
                    tf.keras.layers.SimpleRNN.from_config = original_from_config
                    tf.keras.layers.LSTM.from_config = original_from_config
                    tf.keras.layers.GRU.from_config = original_from_config
                
                # Попытка 2: Загрузка через h5py напрямую и пересоздание модели
                try:
                    import h5py
                    
                    # Создаем архитектуру заново
                    with h5py.File(model_path, 'r') as h5file:
                        # Получаем модель как JSON
                        if 'model_config' in h5file.attrs:
                            model_config = h5file.attrs['model_config']
                            # Преобразуем из байтов в строку и из строки в JSON
                            import json
                            if isinstance(model_config, bytes):
                                model_config = model_config.decode('utf-8')
                            config = json.loads(model_config)
                            
                            # Исправляем конфигурацию для всех слоев
                            for layer in config.get('config', {}).get('layers', []):
                                if 'config' in layer:
                                    layer_config = layer['config']
                                    # Удаляем проблемные параметры
                                    layer_config.pop('time_major', None)
                                    if 'recurrent_activation' in layer_config and layer_config['recurrent_activation'] == 'hard_sigmoid':
                                        layer_config['recurrent_activation'] = 'sigmoid'
                                    
                                    # Проверяем слой Bidirectional, который может содержать RNN слой
                                    if layer.get('class_name') == 'Bidirectional' and 'layer' in layer_config:
                                        inner_layer = layer_config['layer']
                                        if 'config' in inner_layer:
                                            inner_config = inner_layer['config']
                                            inner_config.pop('time_major', None)
                                            if 'recurrent_activation' in inner_config and inner_config['recurrent_activation'] == 'hard_sigmoid':
                                                inner_config['recurrent_activation'] = 'sigmoid'
                                
                            # Создаем модель из исправленной конфигурации
                            model = tf.keras.models.model_from_json(json.dumps(config), custom_objects=custom_objects)
                            
                            # Загружаем веса
                            if 'model_weights' in h5file:
                                original_weights = []
                                for i, layer in enumerate(model.layers):
                                    weights = []
                                    for w in layer.weights:
                                        # Дополнительно здесь можно загружать веса слоев
                                        weights.append(w)
                                    original_weights.append(weights)
                                model.load_weights(model_path)
                                print("Успешно создана модель из JSON и загружены веса")
                    
                except Exception as e:
                    errors.append(f"Ошибка при создании из JSON: {e}")
                    
                    # Попытка 3: Создаем мок-модель как запасной вариант
                    try:
                        # Создаем простую модель-заглушку для визуализации
                        inputs = tf.keras.layers.Input(shape=(10,))
                        x = tf.keras.layers.Dense(5, activation='relu')(inputs)
                        outputs = tf.keras.layers.Dense(1, activation='sigmoid')(x)
                        model = tf.keras.Model(inputs=inputs, outputs=outputs)
                        model._name = f"Mock model for {os.path.basename(model_path)}"
                        print(f"Создана модель-заглушка в качестве запасного варианта")
                    except Exception as e:
                        errors.append(f"Ошибка при создании модели-заглушки: {e}")
                        print(f"Все попытки загрузки модели не удались. Ошибки: {errors}")
                        return None, None, None
            
            if model is None:
                print(f"Не удалось загрузить модель ни одним из способов. Ошибки: {errors}")
                return None, None, None
            
            # Создаем визуализации
            try:
                architecture_fig = plot_model_architecture(model)
                print("Успешно создана визуализация архитектуры")
            except Exception as e:
                print(f"Ошибка при создании визуализации архитектуры: {e}")
                architecture_fig = None
            
            # Создаем сводку модели
            try:
                summary_fig = plot_model_summary(model)
                print("Успешно создана сводка модели")
            except Exception as e:
                print(f"Ошибка при создании сводки модели: {e}")
                summary_fig = None
            
            return model, architecture_fig, summary_fig
        except Exception as e:
            print(f"Ошибка при визуализации модели: {e}")
            import traceback
            traceback.print_exc()
            return None, None, None
    except Exception as e:
        print(f"Критическая ошибка в visualize_keras_model: {e}")
        import traceback
        traceback.print_exc()
        return None, None, None 