@echo off
SETLOCAL

echo Настройка конфигурации визуализатора моделей нейронных сетей
echo ============================================================

:: Проверяем наличие venv и активируем его если есть
if exist "%~dp0venv\Scripts\activate.bat" (
    echo Активация виртуального окружения...
    call "%~dp0venv\Scripts\activate.bat"
) else (
    echo Виртуальное окружение не найдено.
    echo Используется системный Python.
)

:: Запускаем скрипт настройки конфигурации
echo.
echo Запуск настройки конфигурации...
python "%~dp0setup_config.py" %*

:: Если команда не найдена, пробуем запустить через python3
if %ERRORLEVEL% NEQ 0 (
    echo Попытка запуска через python3...
    python3 "%~dp0setup_config.py" %*
)

:: Если все еще ошибка, сообщаем пользователю
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo ОШИБКА: Не удалось запустить скрипт настройки.
    echo Убедитесь, что Python установлен и доступен в PATH.
    echo Если вы используете виртуальное окружение, убедитесь что оно активировано.
    echo.
    echo Вы можете настроить конфигурацию вручную, отредактировав файл:
    echo %~dp0config.ini
)

echo.
echo Нажмите любую клавишу для завершения...
pause > nul

ENDLOCAL 