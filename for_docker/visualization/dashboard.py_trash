# Определение функций для работы с данными
def load_data(file_path):
    """Загружает данные из файла."""
    try:
        if isinstance(file_path, str) or isinstance(file_path, Path):
            return pd.read_csv(file_path)
        else:
            # Для загруженных через Streamlit файлов
            return pd.read_csv(file_path)
    except Exception as e:
        log_error(e, section="load_data", context=f"file_path: {file_path}")
        return None

# Определение функций для анализа данных
def create_data_preview(df):
    """Создает предпросмотр данных с базовой статистикой."""
    preview = {}
    preview["shape"] = df.shape
    preview["head"] = df.head(5)
    preview["describe"] = df.describe()
    preview["info"] = df.dtypes
    preview["missing"] = df.isnull().sum()
    return preview

def create_distribution_plots(df, columns):
    """Создает графики распределения для выбранных колонок."""
    figs = []
    for col in columns:
        fig = px.histogram(df, x=col, title=f"Распределение {col}")
        figs.append(fig)
    return figs

def create_correlation_heatmap(df):
    """Создает тепловую карту корреляций."""
    # Выбираем только числовые столбцы
    numeric_df = df.select_dtypes(include=['number'])
    
    # Вычисляем корреляцию
    corr = numeric_df.corr()
    
    # Создаем тепловую карту
    fig = px.imshow(
        corr,
        text_auto=True,
        aspect="auto",
        color_continuous_scale='RdBu_r',
        title="Матрица корреляций"
    )
    return fig

def create_timeseries_analysis(df, time_col, target_cols):
    """Создает графики временных рядов."""
    figs = []
    for col in target_cols:
        fig = px.line(df, x=time_col, y=col, title=f"Временной ряд {col}")
        figs.append(fig)
    return figs

# Функции для работы с моделями и их результатами
def parse_model_results(file_path):
    """Парсит результаты обучения модели из CSV-файла."""
    try:
        # Загружаем CSV с результатами
        if isinstance(file_path, str) or isinstance(file_path, Path):
            results_df = pd.read_csv(file_path)
        else:
            # Для загруженных через Streamlit файлов
            results_df = pd.read_csv(file_path)
        
        # Создаем структуру данных для хранения информации о модели
        model_name = os.path.basename(str(file_path)).replace("_results.csv", "")
        model_data = {
            "name": model_name,
            "metrics": {},
            "feature_importance": {},
            "predictions": None,
            "actual": None,
            "training_history": {}
        }
        
        # Извлекаем метрики
        for metric in STANDARD_METRICS:
            if metric in results_df.columns:
                model_data["metrics"][metric] = results_df[metric].iloc[0]
        
        # Получаем важность признаков, если есть
        feature_cols = [col for col in results_df.columns if col.startswith("feature_")]
        if feature_cols:
            # Первая строка содержит важность признаков
            for col in feature_cols:
                feature_name = col.replace("feature_", "")
                model_data["feature_importance"][feature_name] = results_df[col].iloc[0]
        
        # Получаем историю обучения, если есть
        history_cols = [col for col in results_df.columns if col.startswith("history_")]
        if history_cols:
            for col in history_cols:
                metric_name = col.replace("history_", "")
                # Предполагаем, что история хранится как строка списка
                history_str = results_df[col].iloc[0]
                if isinstance(history_str, str):
                    try:
                        # Пытаемся преобразовать строку в список
                        history_values = json.loads(history_str)
                        model_data["training_history"][metric_name] = history_values
                    except:
                        # Если не удалось преобразовать, просто пропускаем
                        pass
        
        # Получаем предсказания и фактические значения, если есть
        if "predictions" in results_df.columns:
            try:
                predictions_str = results_df["predictions"].iloc[0]
                model_data["predictions"] = json.loads(predictions_str)
            except:
                pass
        
        if "actual" in results_df.columns:
            try:
                actual_str = results_df["actual"].iloc[0]
                model_data["actual"] = json.loads(actual_str)
            except:
                pass
        
        return model_data
    
    except Exception as e:
        log_error(e, section="parse_model_results", context=f"file_path: {file_path}")
        return None

def create_model_comparison(models_data):
    """Создает график сравнения метрик моделей."""
    # Собираем данные для построения
    models = []
    metrics = []
    values = []
    
    for model_data in models_data:
        model_name = model_data["name"]
        for metric, value in model_data["metrics"].items():
            models.append(model_name)
            metrics.append(METRIC_DISPLAY_NAMES.get(metric, metric))
            values.append(value)
    
    # Создаем DataFrame для построения
    df = pd.DataFrame({
        "Модель": models,
        "Метрика": metrics,
        "Значение": values
    })
    
    # Создаем график
    fig = px.bar(
        df,
        x="Модель",
        y="Значение",
        color="Метрика",
        barmode="group",
        title="Сравнение метрик моделей"
    )
    
    return fig

def create_feature_importance_plot(model_data):
    """Создает график важности признаков."""
    if not model_data["feature_importance"]:
        return None
    
    # Сортируем признаки по важности
    sorted_features = sorted(
        model_data["feature_importance"].items(),
        key=lambda x: x[1],
        reverse=True
    )
    
    features = [item[0] for item in sorted_features]
    importance = [item[1] for item in sorted_features]
    
    # Создаем график
    fig = px.bar(
        x=importance,
        y=features,
        orientation='h',
        title=f"Важность признаков для модели {model_data['name']}"
    )
    
    return fig

def create_prediction_plots(model_data):
    """Создает графики сравнения прогнозов с фактическими значениями."""
    figs = []
    
    if not model_data["predictions"] or not model_data["actual"]:
        return figs
    
    # Получаем данные
    predictions = model_data["predictions"]
    actual = model_data["actual"]
    
    # Создаем график сравнения
    fig = go.Figure()
    
    fig.add_trace(go.Scatter(
        y=actual,
        mode="lines",
        name="Фактические значения"
    ))
    
    fig.add_trace(go.Scatter(
        y=predictions,
        mode="lines",
        name="Прогноз модели",
        line=dict(dash="dash")
    ))
    
    fig.update_layout(
        title=f"Сравнение прогнозов модели {model_data['name']} с фактическими значениями",
        xaxis_title="Временной шаг",
        yaxis_title="Значение"
    )
    
    figs.append(fig)
    
    # Добавляем график ошибок
    errors = [pred - act for pred, act in zip(predictions, actual)]
    
    fig_errors = go.Figure()
    
    fig_errors.add_trace(go.Scatter(
        y=errors,
        mode="lines",
        name="Ошибка прогноза"
    ))
    
    fig_errors.update_layout(
        title=f"Ошибки прогнозирования модели {model_data['name']}",
        xaxis_title="Временной шаг",
        yaxis_title="Ошибка (прогноз - факт)"
    )
    
    figs.append(fig_errors)
    
    return figs

