# Функция для сбора системной информации
def log_system_info():
    """Собирает и логирует информацию о системе."""
    try:
        import platform
        import sys
        
        system_info = {
            "OS": platform.platform(),
            "Python": platform.python_version(),
            "TensorFlow": "Не доступен" if not TENSORFLOW_AVAILABLE else tf.__version__,
            "NumPy": np.__version__,
            "Pandas": pd.__version__,
            "Streamlit": st.__version__,
            "Работающий каталог": os.getcwd(),
            "PATH к моделям": str(MODELS_PATH),
            "PATH к истории": str(HISTORY_PATH)
        }
        
        logger.info("Системная информация:")
        for key, value in system_info.items():
            logger.info(f"  {key}: {value}")
        
        # Проверяем наличие директорий с данными
        if os.path.exists(MODELS_PATH):
            logger.info(f"Директория моделей существует: {MODELS_PATH}")
            model_files = list(MODELS_PATH.glob("**/*.h5"))
            logger.info(f"Найдено {len(model_files)} файлов моделей")
        else:
            logger.warning(f"Директория моделей не найдена: {MODELS_PATH}")
        
        if os.path.exists(HISTORY_PATH):
            logger.info(f"Директория истории существует: {HISTORY_PATH}")
            history_files = list(HISTORY_PATH.glob("**/*.json"))
            logger.info(f"Найдено {len(history_files)} файлов истории")
        else:
            logger.warning(f"Директория истории не найдена: {HISTORY_PATH}")
        
    except Exception as e:
        log_error(e, section="log_system_info")

